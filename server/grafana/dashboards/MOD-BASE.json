            "type": "influxdb",
            "uid": "afrpmft5s97uod"
          },
          "query": "import \"math\"\n\nfrom(bucket: \"stations\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"weather_station\")\n  |> filter(fn: (r) => r._field == \"temperature\" or r._field == \"humidity\" or r._field == \"wind_speed\")\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      r with\n      _value:\n        if r.temperature >= 27.0 then\n          -8.78469475556\n            + 1.61139411 * r.temperature\n            + 2.33854883889 * r.humidity\n            - 0.14611605 * r.temperature * r.humidity\n            - 0.012308094 * r.temperature * r.temperature\n            - 0.0164248277778 * r.humidity * r.humidity\n            + 0.002211732 * r.temperature * r.temperature * r.humidity\n            + 0.00072546 * r.temperature * r.humidity * r.humidity\n            - 0.000003582 * r.temperature * r.temperature * r.humidity * r.humidity\n        else if r.temperature <= 10.0 and r.wind_speed >= 4.8 then\n          13.12\n            + 0.6215 * r.temperature\n            - 11.37 * math.pow(x: r.wind_speed, y: 0.16)\n            + 0.3965 * r.temperature * math.pow(x: r.wind_speed, y: 0.16)\n        else\n          r.temperature\n  }))\n  |> keep(columns: [\"_time\", \"_value\"])\n  |> last()",
          "refId": "A"
        }
      ],
